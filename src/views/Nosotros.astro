---
/* Página: nosotros. El markup vive en src/markup/nosotros.html, los textos en src/i18n/nosotros.js,
   los estilos en src/styles/nosotros.css y la interacción en src/scripts/nosotros.js */
import Base from '../layouts/Base.astro';
import markup from '../markup/nosotros.html?raw';
import { T } from '../i18n/nosotros.js';
import '../styles/rd-base.css';
import '../styles/nosotros.css';

const { lang = 'es' } = Astro.props;
---
<Base lang={lang} page="nosotros" dict={T} spine={true}>
  <Fragment set:html={markup} />
</Base>

<script>
  import '../scripts/nosotros.js';
</script>
