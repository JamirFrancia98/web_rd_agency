---
/* Contacto — según el diseño de referencia: formulario + canales directos + FAQ */
import Base from '../layouts/Base.astro';
import { T, SVC_KEYS } from '../i18n/contacto.js';
import { useT } from '../i18n/t.js';
import { waLink, EMAIL, PHONE, PHONE_HREF, HOURS } from '../config.js';
import '../styles/rd-base.css';
import '../styles/services.css';
import '../styles/contacto.css';

const { lang = 'es' } = Astro.props;
const t = useT(T, lang);
let wi = 0;
const W = (k, cls = '') => t(k).split(' ').map((w) => ({ w, cls, d: (0.15 + 0.08 * wi++).toFixed(2) }));
---
<Base lang={lang} page="contacto">
  <section class="ct-hero gutter">
    <div class="wrap">
      <span class="badge mono">{t('h.badge')}</span>
      <h1 data-split>{[...W('h.t1'), ...W('h.t2', 'grad-text')].map((x) => <><span class={'w ' + x.cls} style={`animation-delay:${x.d}s`}>{x.w}</span> </>)}</h1>
      <p class="lead">{t('h.sub')}</p>
      <div class="ct-chips mono">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>{t('h.c1')}</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{t('h.c2')}</span>
      </div>
    </div>
    <i class="node" style="left:8%;bottom:10px"></i>
  </section>

  <section class="gutter ct-main">
    <i class="node l" style="top:8%"></i><i class="node l" style="bottom:4%"></i>
    <div class="wrap">
      <div class="ct-label mono">{t('s.label')}</div>
      <div class="ct-grid">
        <form class="ct-form" id="ct-form" action="/api/contacto.php" method="post" novalidate>
          <h2>{t('f.title')}</h2>
          <p class="sub">{t('f.sub')}</p>
          <div class="fgrid">
            <label class="fld"><span>{t('f.name')} *</span><input id="f-nombre" name="nombre" required minlength="2" maxlength="120" autocomplete="name" placeholder={t('f.name.ph')}></label>
            <label class="fld"><span>{t('f.company')} *</span><input id="f-empresa" name="empresa" required minlength="2" maxlength="160" autocomplete="organization" placeholder={t('f.company.ph')}></label>
            <label class="fld"><span>{t('f.email')} *</span><input id="f-email" name="email" type="email" required maxlength="160" autocomplete="email" placeholder={t('f.email.ph')}></label>
            <label class="fld"><span>{t('f.phone')}</span><input id="f-telefono" name="telefono" type="tel" maxlength="40" autocomplete="tel" placeholder={t('f.phone.ph')}></label>
            <label class="fld"><span>{t('f.service')}</span>
              <select id="f-servicio" name="servicio">{t('svc').map((s, i) => <option value={s} data-k={SVC_KEYS[i]} selected={i === 1}>{s}</option>)}</select></label>
            <label class="fld"><span>{t('f.budget')}</span>
              <select id="f-presupuesto" name="presupuesto">{t('bud').map((b, i) => <option value={b} selected={i === 2}>{b}</option>)}</select></label>
            <label class="fld full"><span>{t('f.msg')} *</span><textarea id="f-mensaje" name="mensaje" required minlength="10" maxlength="5000" rows="5" placeholder={t('f.msg.ph')}></textarea></label>
          </div>
          <div class="hp" aria-hidden="true"><label>Website<input name="website" id="f-website" tabindex="-1" autocomplete="off"></label></div>
          <input type="hidden" name="ts" id="f-ts" value="0">
          <input type="hidden" name="lang" value={lang}>
          <p class="ferr" id="ferr" role="alert" hidden></p>
          <button class="send" type="submit" id="send"><span>{t('f.send')}</span> <span aria-hidden="true">→</span></button>
          <p class="priv">{t('f.privacy')}</p>
          <div class="done" id="done" hidden>
            <span class="tick">✓</span><h3>{t('f.ok.t')}</h3><p>{t('f.ok.d')}</p>
            <button type="button" class="btn" id="again">{t('f.again')}</button>
          </div>
        </form>

        <aside class="ct-side">
          <div class="card wa-card">
            <div class="wa-head"><span class="ct-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"/><path d="M8 10h8M8 13.5h5"/></svg></span>
              <span class="avail mono" id="avail" data-open={HOURS.open} data-close={HOURS.close}><i></i><span>{t('wa.on')}</span></span></div>
            <h3>{t('wa.title')}</h3>
            <p>{t('wa.sub')}</p>
            <a class="wa-btn" href={waLink(t('wa.msg'))} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8z"/></svg>{t('wa.btn')}</a>
          </div>
          <div class="pair">
            <div class="card mini">
              <span class="ct-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
              <small class="mono">{t('em.k')}</small>
              <a class="val mono" href={'mailto:' + EMAIL} id="email">{EMAIL}</a>
              <button type="button" class="link mono" id="copy" data-ok={t('em.copied')}>{t('em.copy')} →</button>
            </div>
            <div class="card mini">
              <span class="ct-ic pink"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg></span>
              <small class="mono">{t('ph.k')}</small>
              <a class="val mono" href={'tel:' + PHONE_HREF}>{PHONE}</a>
              <span class="dim mono">{t('ph.days')}</span>
            </div>
          </div>
          <div class="card hours">
            <span class="ct-ic blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <div class="hrs">
              <div><small class="mono">{t('hr.k')}</small><b class="mono">{HOURS.open} - {HOURS.close} ({HOURS.tz})</b></div>
              <div class="crit"><small class="mono">{t('hr.crit')}</small><b class="mono">24/7/365 SRE</b></div>
              <div class="now"><small class="mono">{t('hr.local')}</small><b class="mono" id="lima">--:--</b></div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="sec gutter">
    <i class="node r" style="top:10%"></i><i class="node r" style="bottom:12%"></i>
    <div class="wrap ct-faq">
      <div class="ct-label mono">{t('q.label')}</div>
      <h2 class="h2">{t('q.title')}</h2>
      <div class="faq">{t('q').map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/contacto.js';
</script>
