---
/* Plantilla común: <head>, header, línea de luz, contenido traducido y footer. */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Spine from '../components/Spine.astro';
import { UI } from '../i18n/ui.js';
import { ROUTES, LANGS } from '../i18n/routes.js';
import { ssrTranslate } from '../i18n/ssr.js';
import '../styles/global.css';

const { lang = 'es', page = 'home', dict = {}, spine = true } = Astro.props;
const [title, description] = UI[lang].meta[page] || UI[lang].meta.home;
const paths = ROUTES[page];
const canonical = paths ? new URL(paths[lang], Astro.site) : new URL(Astro.url.pathname, Astro.site);
const ogLocale = { es: 'es_PE', en: 'en_US', it: 'it_IT' }[lang];

// el contenido de la página se traduce aquí, al compilar
const body = ssrTranslate(await Astro.slots.render('default'), dict, lang);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {paths && LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(paths[l], Astro.site)}>)}
  {paths && <link rel="alternate" hreflang="x-default" href={new URL(paths.es, Astro.site)}>}
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content={ogLocale}>
  <meta name="theme-color" content="#09090c">
  <meta name="color-scheme" content="dark">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body data-page={page}>
  <Header lang={lang} page={page} />
  <main id="top">
    {spine && <Spine />}
    <div id="contenido" tabindex="-1"></div>
    <Fragment set:html={body} />
    <Footer lang={lang} drawn={!spine} />
  </main>
</body>
</html>
